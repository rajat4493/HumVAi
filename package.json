{
  "name": "humans-vs-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace @hva/web",
    "verify:levels": "npm run verify:levels --workspace @hva/game-core",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts tests/e2e/screens.spec.ts tests/e2e/screens-rivalry.spec.ts --project=desktop --project=mobile",
    "check": "npm run typecheck && npm run lint && npm test && npm run verify:levels && npm run verify:recordings && npm run build && npm run scan:bundle",
    "recordings": "playwright test tests/e2e/recording.spec.ts --project=rec-desktop --project=rec-mobile",
    "runner": "npm run runner --workspace @hva/runner --",
    "scan:bundle": "node tools/scan-bundle.mjs",
    "fixtures": "tsx tools/make-fixtures.ts",
    "verify:recordings": "tsx tools/verify-recordings.ts",
    "verify:subpath": "node tools/check-subpath.mjs",
    "live-smoke": "node tools/live-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.7"
  }
}
